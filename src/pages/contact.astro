---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Volt Local for custom trades business websites, local SEO, and Google Business Profile management."
  breadcrumbs={[{ name: 'Contact', url: '/contact/' }]}
>
  <!-- Hero -->
  <section class="relative pt-28 pb-16 overflow-hidden">
    <div class="absolute inset-0">
      <img src={`${base}images/hero-contact.jpg`} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-brand-dark/70"></div>
    </div>
    <div class="container-max relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="section-label text-brand-accent">Contact</span>
        <h1 class="mb-4 text-white">Get in Touch</h1>
        <p class="section-description text-white/80">
          Have a question or want to talk about getting your business found online? Reach out. You'll hear back within one business day.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info -->
  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white p-8 lg:p-12 rounded-2xl shadow-sm text-center">
          <h2 class="text-2xl mb-6">Reach Out</h2>

          <div class="space-y-6">
            <!-- Email -->
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-dark-light mb-2">Email</h3>
              <a
                href={`mailto:${siteConfig.contact.email}`}
                class="text-brand-primary text-lg hover:text-brand-primary-dark transition-colors font-medium"
              >
                {siteConfig.contact.email}
              </a>
            </div>

            <!-- Scheduling placeholder -->
            <div class="pt-4 border-t border-surface-alt">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-dark-light mb-2">Schedule a Call</h3>
              <p class="text-brand-dark-light mb-4">
                Prefer to talk it through? Book a free 15-minute consultation.
              </p>
              <span class="inline-block text-sm text-brand-dark-light italic">
                Scheduling link coming soon
              </span>
            </div>

            <!-- What to expect -->
            <div class="pt-4 border-t border-surface-alt text-left">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-dark-light mb-4 text-center">What to Expect</h3>
              <ul class="space-y-3 text-brand-dark-light">
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Response within one business day</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Free initial consultation — no obligation</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Honest assessment of your current online presence</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Clear pricing with no surprises</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Timeline -->
  <section class="section-padding pt-0">
    <div class="container-max">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl text-center mb-10">How It Works</h2>

        <div class="space-y-8">
          <!-- Step 1 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-white font-heading font-bold text-sm">1</div>
            <div>
              <h3 class="text-lg mb-1">We Talk</h3>
              <p class="text-brand-dark-light">Quick conversation about your business, your service area, and what you're looking for. No pressure, no sales pitch — just figuring out if it's a fit.</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-white font-heading font-bold text-sm">2</div>
            <div>
              <h3 class="text-lg mb-1">I Build Your Site</h3>
              <p class="text-brand-dark-light">Your custom website goes live within 2–3 weeks. SEO-ready from day one — fast, mobile-friendly, and built around the services and areas you want to rank for.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-brand-primary rounded-full flex items-center justify-center text-white font-heading font-bold text-sm">3</div>
            <div>
              <h3 class="text-lg mb-1">Monthly SEO & GBP Work Begins</h3>
              <p class="text-brand-dark-light">Once your site is live, ongoing optimization begins — local SEO, Google Business Profile updates, and content targeting the searches your customers are making.</p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-brand-accent rounded-full flex items-center justify-center text-white font-heading font-bold text-sm">4</div>
            <div>
              <h3 class="text-lg mb-1">Results Start Compounding</h3>
              <p class="text-brand-dark-light">Most businesses see meaningful movement in search rankings around month three. You get a plain-English report every month so you always know where things stand.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
