---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden min-h-[80vh] flex items-center pt-16">
    <div class="absolute inset-0">
      <img
        src={`${base}images/hero-home.jpg`}
        alt=""
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-brand-dark/70"></div>
    </div>
    <div class="container-max relative z-10 py-20">
      <div class="max-w-2xl">
        <span class="section-label text-brand-accent">Websites, SEO & GBP for Trades Businesses</span>
        <h1 class="mb-6 text-white">
          Personal Service. Small Operator Price.
        </h1>
        <p class="text-lg text-white/80 mb-8 max-w-xl">
          Websites, SEO, and Google Business Profile management for HVAC, plumbing, electrical, and other trades businesses. You focus on the jobs — your online presence gets handled.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={`${base}contact/`} class="btn btn-primary btn-lg">
            Get a Free Consultation
          </a>
          <a href={`${base}services/`} class="btn bg-transparent text-white border-white hover:bg-white hover:text-brand-primary btn-lg">
            See How It Works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section-padding bg-surface-alt" id="services">
    <div class="container-max">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="section-label">What I Do</span>
        <h2 class="section-title">Three Things. Done Right.</h2>
        <p class="section-description">
          Websites, SEO, and Google Business Profile management. I don't do social media. I don't run ads. I focus on what actually moves the needle for trades businesses.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {siteConfig.services.map((service) => (
          <div class="service-card">
            <div class="service-icon">
              {service.icon === 'search' && (
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              )}
              {service.icon === 'code' && (
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
              {service.icon === 'map' && (
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
            </div>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href={`${base}services/`} class="btn btn-outline">
          Learn More About Services
        </a>
      </div>
    </div>
  </section>

  <!-- Why Volt Local -->
  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="section-label">Why Volt Local</span>
          <h2 class="section-title">Built for Small Operators</h2>
          <p class="section-description max-w-2xl mx-auto">
            So you can focus on running your business, not your online presence.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-sm">
            <div class="w-10 h-10 bg-brand-accent/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="text-lg mb-2">I Know Local Search</h3>
            <p class="text-brand-dark-light">I know how local search works for service-area businesses — the site structure, the keyword patterns, the GBP signals that actually drive calls. I learn your specific market, your service area, and your competition so the work is targeted from day one.</p>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm">
            <div class="w-10 h-10 bg-brand-accent/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg mb-2">No Packages. No Upsells.</h3>
            <p class="text-brand-dark-light">Website build, SEO, GBP management. That's the whole list. I don't tack on social media packages, ad management, or anything else to pad the bill. You know exactly what you're paying for.</p>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm">
            <div class="w-10 h-10 bg-brand-accent/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-lg mb-2">Direct Access. No Layers.</h3>
            <p class="text-brand-dark-light">Volt Local stays small on purpose so every client gets real attention. No account managers, no handoffs, no ticket queues. You reach out, you get a real answer.</p>
          </div>

          <div class="bg-white p-8 rounded-2xl shadow-sm">
            <div class="w-10 h-10 bg-brand-accent/10 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg mb-2">Your Site. Your Code. No Lock-In.</h3>
            <p class="text-brand-dark-light">Everything I build is yours — the code, the content, the design. No proprietary platforms, no hostage situations. If you move on, you take it all with you.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding">
    <div class="container-max">
      <div class="cta-section max-w-4xl mx-auto">
        <h3 class="text-2xl md:text-3xl">Ready to Get Found?</h3>
        <p class="text-lg max-w-xl mx-auto">
          A quick conversation about your business — no pressure, no sales pitch.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={`${base}contact/`} class="btn btn-primary bg-brand-accent border-brand-accent hover:bg-brand-accent-dark hover:border-brand-accent-dark">
            Get Started
          </a>
          <a href={`${base}services/`} class="btn bg-transparent text-white border-white hover:bg-white hover:text-brand-primary">
            View Services
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
