---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About"
  description="Volt Local builds websites and manages SEO specifically for trades businesses — HVAC, plumbing, electrical, and more."
  breadcrumbs={[{ name: 'About', url: '/about/' }]}
>
  <!-- Hero -->
  <section class="relative pt-28 pb-16 overflow-hidden">
    <div class="absolute inset-0">
      <img src={`${base}images/hero-about.jpg`} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-brand-dark/70"></div>
    </div>
    <div class="container-max relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="section-label text-brand-accent">About</span>
        <h1 class="mb-4 text-white">Why Volt Local Exists</h1>
        <p class="section-description text-white/80">
          Small trades businesses shouldn't have to outspend their competitors to get found online. They just need someone who knows what they're doing.
        </p>
      </div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-3xl mx-auto">
        <div class="space-y-6 text-brand-dark-light text-lg leading-relaxed">
          <p>
            I come from a software background. I've been building websites for years. When I built a site for a trades business, I dug into the local SEO and GBP side of things and realized most trades businesses were stuck in one of two bad situations: overpaying an agency that treats them like an afterthought, or running on a website that wasn't doing anything for them.
          </p>
          <p>
            So I started Volt Local. The idea is simple: give small trades businesses the same quality of website and SEO work that the big spenders get, but at a price that actually makes sense for a small operation.
          </p>
          <p>
            I can do this because I keep my overhead low and my focus narrow. I only do three things — websites, SEO, and Google Business Profile management. No social media. No ads. No bloated packages full of services you don't need. Just the stuff that actually gets you found when someone in your area searches for what you do.
          </p>

          <!-- Philosophy Box -->
          <div class="bg-surface-alt p-6 rounded-lg my-8 border-l-4 border-brand-accent">
            <h3 class="text-base mb-2 text-brand-dark font-heading font-bold">How I Work</h3>
            <p class="mb-2">
              I'm a small operator, same as you. I build your site, manage your SEO, and handle your GBP. One person owns the entire stack. You get the personal attention of an agency — someone who actually knows your business, your service area, and your competition — at a price closer to the high-volume SEO shops.
            </p>
            <p class="mb-0">
              No jargon, no contracts, no upsells. Clear communication. Measurable results.
            </p>
          </div>

          <p>
            Your website is yours — the code, the content, everything. If you move on, you take it with you. No lock-in, no proprietary platforms, no hostage situations.
          </p>

          <p>
            That's what Volt Local is — a way for small trades businesses to compete online without getting gouged on price or lost in the shuffle at a big agency.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding pt-0">
    <div class="container-max">
      <div class="cta-section max-w-4xl mx-auto">
        <h3 class="text-2xl md:text-3xl">Let's Get Your Business Found</h3>
        <p class="text-lg max-w-xl mx-auto">
          Ready to show up when customers in your area search for the services you provide? Get in touch.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={`${base}contact/`} class="btn btn-primary bg-brand-accent border-brand-accent hover:bg-brand-accent-dark hover:border-brand-accent-dark">
            Get in Touch
          </a>
          <a href={`${base}services/`} class="btn bg-transparent text-white border-white hover:bg-white hover:text-brand-primary">
            View Services
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
